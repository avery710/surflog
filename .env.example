# Copy to .env.local (already gitignored) and fill in. See README.md
# "Setting up Google sign-in" for how to get the Google values.

# Auth.js session/cookie signing secret. Generate with:
#   npx auth secret
# (writes it straight into .env.local) or `openssl rand -base64 33`.
AUTH_SECRET=

# From the OAuth client you create in Google Cloud Console (APIs & Services
# > Credentials > Create Credentials > OAuth client ID > Web application).
# Auth.js's Google provider picks these up automatically by this exact name
# — no other config needed.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. The 3 real sessions logged before login existed (Capy's) have no
# owner. If this is set, the FIRST time someone signs in with this exact
# email, those sessions permanently become theirs. Leave unset once that's
# happened once — it only matters until the one-time claim occurs. See
# lib/db.ts `claimLegacySessions`.
LEGACY_OWNER_EMAIL=
